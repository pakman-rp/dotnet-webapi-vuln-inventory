<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    VULN (SCA): package versions pinned old/vulnerable on purpose for SCA
    benchmarking. A "secure" branch would bump these to patched releases.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="6.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="6.0.0" />
    <!-- VULN (SCA): old Newtonsoft.Json with historical high-severity advisories -->
    <PackageReference Include="Newtonsoft.Json" Version="12.0.1" />
    <!-- VULN (SCA): old JWT handling line -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="6.10.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.2.3" />
    <!-- Reachability test: included but never referenced anywhere in source -->
    <PackageReference Include="Microsoft.Data.OData" Version="5.8.4" /> <!-- VULN: unused vulnerable dependency, EOL package -->
  </ItemGroup>

</Project>
